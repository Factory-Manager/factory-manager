{
  // Enables editor validation and autocomplete for Renovate configuration.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Recommended baseline preset maintained by Renovate.
  "extends": ["config:recommended"],

  // Creates a GitHub issue summarizing pending, open, closed, and errored updates.
  "dependencyDashboard": true,

  // Timezone used by schedule-based rules.
  "timezone": "Europe/Rome",

  // Use Conventional Commits for Renovate PR titles and commits.
  // Example: chore(deps): update dependency express to v5.2.2
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",

  // Keep original casing in PR titles and commit messages.
  "commitMessageLowerCase": "never",

  // Label applied to Renovate PRs.
  "labels": ["dependencies"],

  // Maximum number of Renovate PRs open at the same time.
  "prConcurrentLimit": 6,

  // Maximum number of Renovate PRs created per hour.
  "prHourlyLimit": 2,

  // Update package.json ranges together with lockfiles.
  // Example: "express": "^5.2.1" -> "express": "^5.2.2"
  "rangeStrategy": "bump",

  // Split per microservizio, non per singolo file.
  "additionalBranchPrefix": "{{#if (containsString packageFile 'core-rest-service')}}core-rest-service-{{else}}{{#if (containsString packageFile 'machine-simulator-service')}}machine-simulator-service-{{else}}{{#if (containsString packageFile 'coordinator-service')}}coordinator-service-{{else}}{{parentDir}}-{{/if}}{{/if}}{{/if}}",

  // Use strict branch naming to avoid conflicts and ensure clarity.
  "branchNameStrict": true,

  // Assign specific team members to PRs that match certain criteria.
  "packageRules": [
    {
      "description": "Route core-rest-service dependency PRs",
      "matchFileNames": [
        "microservices/core-rest-service/package.json",
        "microservices/core-rest-service/package-lock.json",
        "microservices/core-rest-service/Dockerfile",
        ".github/workflows/core-rest-service.yml"
      ],
      "assignees": ["davidcohenDC"]
    },
    {
      "description": "Route machine-simulator-service dependency PRs",
      "matchFileNames": [
        "microservices/machine-simulator-service/package.json",
        "microservices/machine-simulator-service/package-lock.json",
        "microservices/machine-simulator-service/Dockerfile",
        ".github/workflows/machine-simulator-service.yml"
      ],
      "assignees": ["GiuliaNardicchia"]
    },
    {
      "description": "Route coordinator-service dependency PRs",
      "matchFileNames": [
        "microservices/coordinator-service/package.json",
        "microservices/coordinator-service/package-lock.json",
        "microservices/coordinator-service/Dockerfile",
        ".github/workflows/coordinator-service.yml"
      ],
      "assignees": ["GiuliaNardicchia"]
    }
  ]
}
