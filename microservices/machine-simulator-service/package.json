{
  "name": "machine-simulator-service",
  "version": "0.0.0",
  "description": "Machine sensor data simulator.",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:reporter": "vitest run --coverage --reporter=html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Factory-Manager/factory-manager.git"
  },
  "keywords": [],
  "author": {
    "name": "FactoryManager",
    "url": "https://github.com/Factory-Manager"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Factory-Manager/factory-manager/issues"
  },
  "homepage": "https://github.com/Factory-Manager/factory-manager#readme",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mqtt": "^5.15.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0"
