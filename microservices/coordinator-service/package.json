{
  "name": "factory-manager",
  "version": "0.1.0",
  "description": "Coordinator service for Factory Manager distributed system.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "clean": "rimraf docs coverage",
    "clean:all": "rimraf node_modules package-lock.json docs coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:reporter": "vitest run --coverage --reporter=html",
    "docs": "typedoc --tsconfig tsconfig.json --entryPointStrategy expand src --out docs",
    "docs:clean": "rimraf docs",
    "docs:watch": "typedoc --tsconfig tsconfig.json --entryPointStrategy expand src --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Factory-Manager/factory-manager.git"
  },
  "keywords": [],
  "author": {
    "name": "FactoryManager",
    "url": "https://github.com/Factory-Manager"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Factory-Manager/factory-manager/issues"
  },
  "homepage": "https://github.com/Factory-Manager/factory-manager#readme",
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mqtt": "^5.15.1",
    "pino": "^10.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
