{
  "name": "core-rest-service",
  "version": "0.1.0",
  "private": true,
  "description": "Core REST service for the Factory Manager distributed monitoring system.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-secret node --test \"test/**/*.test.js\"",
    "test:coverage": "cross-env NODE_ENV=test JWT_SECRET=test-secret node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=test/**/*.js \"test/**/*.test.js\"",
    "test:coverage:check": "cross-env NODE_ENV=test JWT_SECRET=test-secret node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=test/**/*.js --test-coverage-lines=60 --test-coverage-functions=60 --test-coverage-branches=60 \"test/**/*.test.js\"",
    "docs:validate": "node scripts/validate-spec.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=10.9.8"
  },
  "contributors": [
    "David Cohen",
    "Giulia Nardicchia"
  ],
  "license": "MIT",
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.1",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4"
  }
}
