#!/usr/bin/env bash
set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m'

remote_name="${1:-}"
ROOT_DIR="$(git rev-parse --show-toplevel)"

echo -e "${BLUE}Running pre-push checks...${NC}"

# Run checks only when pushing to origin
if [ "$remote_name" != "origin" ]; then
  echo -e "${YELLOW}Remote is not origin. Skipping checks.${NC}"
  exit 0
fi

changed_files=""

# Read refs from stdin provided by Git pre-push hook
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deleted branches
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # New remote branch
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      base_sha="$(git merge-base "$local_sha" origin/main)"
    else
      base_sha="$(git rev-list --max-parents=0 "$local_sha")"
    fi
  else
    base_sha="$remote_sha"
  fi

  changed_files+="
$(git diff --name-only "$base_sha" "$local_sha")"
done

if [ -z "$changed_files" ]; then
  echo -e "${YELLOW}No changed files detected. Skipping checks.${NC}"
  exit 0
fi

node_projects=()

add_node_project_if_needed() {
  local project_dir="$1"

  if [ -f "$project_dir/package.json" ]; then
    node_projects+=("$project_dir")
  fi
}

# Root Node project, if present
if echo "$changed_files" | grep -Eq '(^package\.json$|^package-lock\.json$|^src/)'; then
  add_node_project_if_needed "$ROOT_DIR"
fi

# Frontend, if present
if echo "$changed_files" | grep -Eq '^frontend/'; then
  add_node_project_if_needed "$ROOT_DIR/frontend"
fi

# Microservices: only Node.js services with package.json
while IFS= read -r file; do
  if [[ "$file" == microservices/*/* ]]; then
    service_name="$(echo "$file" | cut -d'/' -f2)"
    service_dir="$ROOT_DIR/microservices/$service_name"
    add_node_project_if_needed "$service_dir"
  fi
done <<< "$changed_files"

# Remove duplicates
unique_projects=()
for project in "${node_projects[@]}"; do
  already_added=false

  for existing in "${unique_projects[@]}"; do
    if [ "$existing" = "$project" ]; then
      already_added=true
      break
    fi
  done

  if [ "$already_added" = false ]; then
    unique_projects+=("$project")
  fi
done

if [ "${#unique_projects[@]}" -eq 0 ]; then
  echo -e "${YELLOW}No changed Node.js projects detected. Skipping checks.${NC}"
  exit 0
fi

errors=0
error_messages=""

run_check() {
  local project="$1"
  local name="$2"
  local cmd="$3"

  echo -e "\n${YELLOW}Running $name in $(realpath --relative-to="$ROOT_DIR" "$project")...${NC}"

  output=$(cd "$project" && eval "$cmd" 2>&1) || {
    echo -e "${RED}✗ $name failed${NC}"
    error_messages+="
${RED}[$name Error - $(realpath --relative-to="$ROOT_DIR" "$project")]${NC}
$output
"
    errors=$((errors + 1))
    return 1
  }

  echo -e "${GREEN}✓ $name passed${NC}"
}

for project in "${unique_projects[@]}"; do
  run_check "$project" "lint" "npm run lint --if-present"
  run_check "$project" "format check" "npm run format:check --if-present"
done

if [ "$errors" -gt 0 ]; then
  echo -e "\n${RED}Failed with $errors errors:${NC}"
  echo -e "$error_messages"
  echo -e "\n${YELLOW}Push aborted.${NC}"
  exit 1
fi

echo -e "\n${GREEN}All pre-push checks passed.${NC}"
